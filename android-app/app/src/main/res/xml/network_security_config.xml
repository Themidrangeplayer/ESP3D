<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- The ESP32 serves plain HTTP/WS. Only the local asset origin, the
         loopback proxy, and the ESP32 itself are allowed to use cleartext. -->
    <base-config cleartextTrafficPermitted="false" />

    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">192.168.4.1</domain>
        <domain includeSubdomains="false">appassets.androidplatform.net</domain>
    </domain-config>
</network-security-config>
