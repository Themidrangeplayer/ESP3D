#include <WiFi.h>
#include <WebServer.h>
#include <WebSocketsServer.h>
#include <HijelHID_BLEMouse.h>

const char* AP_SSID = "ESP3D_Controller";
const char* AP_PASSWORD = "ESP3D-1234";

WebServer httpServer(80);
WebSocketsServer webSocket(81);

HijelBLEMouse mouse("ESP3D", "ESP3D Project", 100, 5, true);

const char INDEX_HTML[] PROGMEM = R"rawliteral(
<!DOCTYPE html>
<html>
<head>
<meta name="viewport" content="width=device-width,initial-scale=1,maximum-scale=1,user-scalable=no">
<title>ESP3D Controller</title>
<style>
*{box-sizing:border-box}
body{margin:0;background:#101319;color:#edf2fa;font-family:Arial,sans-serif;touch-action:none}
header{padding:22px;text-align:center;border-bottom:1px solid #303744}
h1{margin:0;font-size:25px;letter-spacing:2px}
.sub{color:#929eaf;font-size:12px;margin-top:7px}
.status{margin:18px auto;padding:10px;width:max-content;border-radius:30px;background:#202a27;color:#83e6b0;font-size:12px}
main{padding:18px;max-width:600px;margin:auto}
.pad{height:290px;background:#1b222d;border:1px solid #394456;border-radius:22px;display:flex;align-items:center;justify-content:center;color:#8492a6;user-select:none}
.pad span{text-align:center;pointer-events:none}
.buttons{display:flex;gap:12px;margin-top:15px}
button{background:#252e3c;border:1px solid #414e61;color:white;border-radius:15px;padding:19px 10px;font-size:15px;flex:1;touch-action:none}
button:active{background:#425875}
.row{display:flex;gap:12px;margin-top:12px}
.small{padding:14px}
footer{text-align:center;color:#657184;font-size:11px;padding:25px}
</style>
</head>
<body>
<header>
<h1>ESP3D</h1>
<div class="sub">WIRELESS CONTROL SYSTEM</div>
</header>
<div class="status" id="status">Connecting to ESP32...</div>
<main>
<div class="pad" id="pad"><span>TOUCHPAD<br><br>Move your finger to control the mouse</span></div>
<div class="buttons">
<button id="left">LEFT CLICK</button>
<button id="right">RIGHT CLICK</button>
<button id="middle">MIDDLE</button>
</div>
<div class="row">
<button class="small" id="scrollUp">▲ SCROLL</button>
<button class="small" id="scrollDown">▼ SCROLL</button>
</div>
</main>
<footer>ESP3D · LOCAL WIRELESS CONTROL</footer>
<script>
const statusEl=document.getElementById('status');
let ws;
function connect(){
 ws=new WebSocket('ws://192.168.4.1:81/');
 ws.onopen=()=>statusEl.textContent='PHONE CONNECTED · READY';
 ws.onclose=()=>{statusEl.textContent='DISCONNECTED · RECONNECTING';setTimeout(connect,1500)};
 ws.onerror=()=>ws.close();
}
connect();
function send(data){if(ws&&ws.readyState===1)ws.send(data)}
const pad=document.getElementById('pad');
let last=null;
pad.addEventListener('pointerdown',e=>{last={x:e.clientX,y:e.clientY};pad.setPointerCapture(e.pointerId)});
pad.addEventListener('pointermove',e=>{
 if(!last)return;
 const dx=Math.round((e.clientX-last.x)*1.5);
 const dy=Math.round((e.clientY-last.y)*1.5);
 last={x:e.clientX,y:e.clientY};
 if(dx||dy)send('M '+dx+' '+dy);
});
function stop(){last=null}
pad.addEventListener('pointerup',stop);
pad.addEventListener('pointercancel',stop);
function button(id,code){
 const el=document.getElementById(id);
 el.addEventListener('pointerdown',e=>{e.preventDefault();send('B '+code+' 1')});
 el.addEventListener('pointerup',()=>send('B '+code+' 0'));
 el.addEventListener('pointercancel',()=>send('B '+code+' 0'));
 el.addEventListener('pointerleave',()=>send('B '+code+' 0'));
}
button('left','L');button('right','R');button('middle','M');
document.getElementById('scrollUp').onclick=()=>send('S 3');
document.getElementById('scrollDown').onclick=()=>send('S -3');
</script>
</body>
</html>
)rawliteral";

void handleWebSocket(uint8_t client, WStype_t type, uint8_t * payload, size_t length) {
  if (type == WStype_DISCONNECTED) {
    mouse.releaseAll();
    return;
  }

  if (type != WStype_TEXT || length == 0 || length > 40) return;

  char message[41];
  memcpy(message, payload, length);
  message[length] = '\0';

  int dx, dy;
  char button;
  int pressed;
  int value;

  if (sscanf(message, "M %d %d", &dx, &dy) == 2) {
    dx = constrain(dx, -127, 127);
    dy = constrain(dy, -127, 127);
    if (mouse.isConnected()) mouse.move(dx, dy);
  }
  else if (sscanf(message, "B %c %d", &button, &pressed) == 2) {
    if (!mouse.isConnected()) return;
    MouseButton b;
    if (button == 'L') b = MouseButton::Left;
    else if (button == 'R') b = MouseButton::Right;
    else if (button == 'M') b = MouseButton::Middle;
    else return;
    mouse.setButton(b, pressed != 0);
  }
  else if (sscanf(message, "S %d", &value) == 1) {
    value = constrain(value, -10, 10);
    if (mouse.isConnected()) mouse.addScroll(value);
  }
}

void setup() {
  Serial.begin(115200);

  WiFi.mode(WIFI_AP);
  WiFi.softAP(AP_SSID, AP_PASSWORD, 1, false, 1);

  httpServer.on("/", HTTP_GET, []() {
    httpServer.send_P(200, "text/html", INDEX_HTML);
  });
  httpServer.begin();

  mouse.setLogLevel(HIDLogLevel::Normal);
  mouse.setUpdateRate(HIDRate::Hz125);
  mouse.begin();

  webSocket.begin();
  webSocket.onEvent(handleWebSocket);

  Serial.println("ESP3D ready");
  Serial.println("Phone Wi-Fi: ESP3D_Controller");
  Serial.println("Password: ESP3D-1234");
  Serial.println("Open: http://192.168.4.1");
}

void loop() {
  httpServer.handleClient();
  webSocket.loop();
  delay(1);
}
