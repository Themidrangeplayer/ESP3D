#include <WiFi.h>
#include <WebServer.h>
#include <WebSocketsServer.h>
#include <HijelHID_BLEMouse.h>
#include "web_ui.h"

const char* AP_SSID = "ESP3D_Controller";
const char* AP_PASSWORD = "ESP3D-1234";

WebServer httpServer(80);
WebSocketsServer webSocket(81);
HijelBLEMouse mouse("ESP3D", "ESP3D Project", 100, 5, true);

void handleWebSocket(uint8_t client, WStype_t type,
                     uint8_t *payload, size_t length) {
  if(type == WStype_DISCONNECTED) {
    mouse.releaseAll();
    return;
  }

  if(type != WStype_TEXT || length == 0 || length > 40) return;

  char message[41];
  memcpy(message, payload, length);
  message[length] = '\0';

  int dx, dy, pressed, value;
  char button;

  if(sscanf(message, "M %d %d", &dx, &dy) == 2) {
    if(!mouse.isConnected()) return;
    mouse.move(constrain(dx,-127,127), constrain(dy,-127,127));
  }
  else if(sscanf(message, "B %c %d", &button, &pressed) == 2) {
    if(!mouse.isConnected() || (pressed != 0 && pressed != 1)) return;

    MouseButton b;
    if(button == 'L') b = MouseButton::Left;
    else if(button == 'R') b = MouseButton::Right;
    else if(button == 'M') b = MouseButton::Middle;
    else return;

    mouse.setButton(b, pressed == 1);
  }
  else if(sscanf(message, "S %d", &value) == 1) {
    if(mouse.isConnected()) {
      mouse.addScroll(constrain(value,-10,10));
    }
  }
}

void setup() {
  Serial.begin(115200);

  WiFi.mode(WIFI_AP);
  WiFi.softAP(AP_SSID, AP_PASSWORD, 1, false, 1);

  httpServer.on("/", HTTP_GET, []() {
    httpServer.send_P(200, "text/html", INDEX_HTML);
  });

  httpServer.on("/style.css", HTTP_GET, []() {
    httpServer.send_P(200, "text/css", STYLE_CSS);
  });

  httpServer.on("/app.js", HTTP_GET, []() {
    httpServer.send_P(200, "application/javascript", APP_JS);
  });

  httpServer.on("/status", HTTP_GET, []() {
    String result = "{\"ble\":";
    result += mouse.isConnected() ? "true" : "false";
    result += "}";
    httpServer.send(200, "application/json", result);
  });

  httpServer.begin();

  mouse.setLogLevel(HIDLogLevel::Normal);
  mouse.setUpdateRate(HIDRate::Hz125);
  mouse.begin();

  webSocket.begin();
  webSocket.onEvent(handleWebSocket);

  Serial.println("ESP3D ready");
  Serial.println("Wi-Fi: ESP3D_Controller");
  Serial.println("Password: ESP3D-1234");
  Serial.println("Open: http://192.168.4.1");
}

void loop() {
  httpServer.handleClient();
  webSocket.loop();
  delay(1);
}
